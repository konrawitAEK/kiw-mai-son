# Copy to .env and fill real values locally (never commit .env).
# Real values live in Supabase secrets / GitHub repo secrets, not here.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Encryption for shop LINE channel tokens (stored encrypted at rest) ---
CHANNEL_TOKEN_ENC_KEY=
# Generate once: openssl rand -base64 32   (losing it makes stored channel tokens unreadable)

# --- Shop onboarding (T13): LIFF app id for rich menu links; optional invite code gating who can create a shop ---
LIFF_ID=
ONBOARDING_INVITE_CODE=

# --- Founder alerts (T15): functions push errors / failed reminders to the founder's own LINE ---
# Messaging API channel access token of the founder's own (free) OA, and the founder's LINE user id.
# (LINE Notify was discontinued in 2025, so it is not used.)
FOUNDER_LINE_CHANNEL_TOKEN=
FOUNDER_LINE_USER_ID=

# --- LIFF (customer booking + owner admin pages) ---
VITE_LIFF_ID=
VITE_API_BASE_URL=

# --- LINE Login channel id (verifies LIFF ID tokens in the API function) ---
LINE_LOGIN_CHANNEL_ID=

# --- Reminder job (pg_cron -> Edge Function `reminders`) ---
REMINDER_CRON_SECRET=

# --- Rich menu setup (T9): run `pnpm rich-menu --shop-id <id> --image menu.png`; one shop's channel token, passed per run, never stored ---
LINE_CHANNEL_ACCESS_TOKEN=

# --- Monthly summary (T16): pg_cron -> Edge Function `monthly-stats` (day 25) ---
MONTHLY_STATS_CRON_SECRET=
# Fallback payment link for the summary, used only when LIFF_ID is unset (T17: the summary links to the shop's own billing page). Optional.
BILLING_PAYMENT_URL=

# --- Billing (T17): shops pay the founder via PromptPay QR (199/month or 1,990/year) ---
# The founder's own PromptPay ID (phone 10 digits or national/tax ID 13 digits) that the QR pays to.
FOUNDER_PROMPTPAY_ID=
# Daily trial-ending reminders: pg_cron -> Edge Function `billing-reminders`
BILLING_CRON_SECRET=
# Only FOUNDER_LINE_USER_ID (above) may call POST /billing/mark-paid; without it billing routes are off.
