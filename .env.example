# Copy to .env and fill real values locally (never commit .env).
# Real values live in Supabase secrets / GitHub repo secrets, not here.

# --- Supabase ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=

# --- Encryption for shop LINE channel tokens (stored encrypted at rest) ---
CHANNEL_TOKEN_ENC_KEY=
# Generate once: openssl rand -base64 32   (losing it makes stored channel tokens unreadable)

# --- Shop onboarding (T13): LIFF app id for rich menu links; optional invite code gating who can create a shop ---
LIFF_ID=
ONBOARDING_INVITE_CODE=

# --- Founder alert channel (monitoring -> founder's own LINE) ---
FOUNDER_LINE_NOTIFY_TOKEN=

# --- LIFF (customer booking + owner admin pages) ---
VITE_LIFF_ID=
VITE_API_BASE_URL=

# --- LINE Login channel id (verifies LIFF ID tokens in the API function) ---
LINE_LOGIN_CHANNEL_ID=

# --- Reminder job (pg_cron -> Edge Function `reminders`) ---
REMINDER_CRON_SECRET=

# --- Rich menu setup (T9): run `pnpm rich-menu --shop-id <id> --image menu.png`; one shop's channel token, passed per run, never stored ---
LINE_CHANNEL_ACCESS_TOKEN=
